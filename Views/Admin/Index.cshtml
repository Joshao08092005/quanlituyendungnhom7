@{
    // Khai báo sử dụng khung giao diện AdminLTE vừa tạo
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bảng điều khiển";
}


<div class="row">
    <!-- Khối thống kê 1: Người dùng mới -->
    <div class="col-lg-4 col-6">
        <div class="small-box text-bg-primary">
            <div class="inner">
                <h3>150</h3>
                <p>Người dùng mới</p>
            </div>
            <div class="small-box-icon">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            <a href="#" class="small-box-footer">
                Xem chi tiết <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    </div>

    <!-- Khối thống kê 2: Hồ sơ ứng tuyển -->
    <div class="col-lg-4 col-6">
        <div class="small-box text-bg-success">
            <div class="inner">
                <h3>53<sup class="fs-5">%</sup></h3>
                <p>Hồ sơ ứng tuyển</p>
            </div>
            <div class="small-box-icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>
            <a href="#" class="small-box-footer">
                Xem chi tiết <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    </div>

    <!-- Khối thống kê 3: Nhà tuyển dụng -->
    <div class="col-lg-4 col-6">
        <div class="small-box text-bg-warning">
            <div class="inner">
                <h3>44</h3>
                <p>Nhà tuyển dụng</p>
            </div>
            <div class="small-box-icon">
                <i class="bi bi-briefcase-fill"></i>
            </div>
            <a href="#" class="small-box-footer">
                Xem chi tiết <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Hoạt động gần đây</h3>
            </div>
            <div class="card-body">
                Đây là khu vực bạn có thể chèn bảng danh sách (Table) hoặc biểu đồ (Chart).
            </div>
        </div>
    </div>
</div>