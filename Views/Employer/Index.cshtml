@{
    Layout = "_AdminLayout"; 
    ViewData["Title"] = "Bảng điều khiển Nhà tuyển dụng";
}

<!-- Hàng 1: Thống kê tổng quan dạng thẻ lớn (Small Boxes) -->
<div class="row">
    <!-- Tin đang tuyển -->
    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-primary">
            <div class="inner">
                <h3>12</h3>
                <p>Tin đang mở tuyển</p>
            </div>
            <div class="small-box-icon">
                <i class="bi bi-briefcase"></i>
            </div>
            <a href="#" class="small-box-footer">Quản lý tin <i class="bi bi-arrow-right-circle"></i></a>
        </div>
    </div>
    
    <!-- Tổng hồ sơ nhận được -->
    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-success">
            <div class="inner">
                <h3>150</h3>
                <p>Tổng hồ sơ đã nhận</p>
            </div>
            <div class="small-box-icon">
                <i class="bi bi-file-earmark-person"></i>
            </div>
            <a href="#" class="small-box-footer">Xem tất cả <i class="bi bi-arrow-right-circle"></i></a>
        </div>
    </div>

    <!-- Hồ sơ mới chưa duyệt -->
    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-warning">
            <div class="inner">
                <h3 class="text-dark">8</h3>
                <p class="text-dark">Hồ sơ mới (Hôm nay)</p>
            </div>
            <div class="small-box-icon">
                <i class="bi bi-bell text-dark"></i>
            </div>
            <a href="#" class="small-box-footer link-dark">Duyệt ngay <i class="bi bi-arrow-right-circle"></i></a>
        </div>
    </div>

    <!-- Lịch phỏng vấn -->
    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-danger">
            <div class="inner">
                <h3>5</h3>
                <p>Lịch phỏng vấn tới</p>
            </div>
            <div class="small-box-icon">
                <i class="bi bi-calendar-check"></i>
            </div>
            <a href="#" class="small-box-footer">Xem lịch <i class="bi bi-arrow-right-circle"></i></a>
        </div>
    </div>
</div>

<!-- Hàng 2: Nội dung chi tiết -->
<div class="row mt-4">
    <!-- Cột trái: Quản lý các chiến dịch / Tin tuyển dụng (Chiếm 8 cột) -->
    <div class="col-lg-8">
        <div class="card mb-4 shadow-sm">
            <div class="card-header border-0 d-flex justify-content-between align-items-center">
                <h3 class="card-title fw-bold">Tin tuyển dụng gần đây</h3>
                <!-- Nút Đăng bài nổi bật -->
                <button class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-circle"></i> Đăng tin mới</button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Tiêu đề / Vị trí</th>
                                <th>Hạn chót</th>
                                <th class="text-center">Số CV</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <strong class="text-primary">Lập trình viên ASP.NET Core</strong><br>
                                    <small class="text-muted">Đăng ngày: 25/10/2026</small>
                                </td>
                                <td>30/11/2026</td>
                                <td class="text-center">
                                    <span class="badge text-bg-info fs-6">24</span>
                                </td>
                                <td><span class="badge text-bg-success">Đang tuyển</span></td>
                                <td class="text-center">
                                    <!-- Các nút thao tác của quản lý -->
                                    <button class="btn btn-outline-primary btn-sm mb-1" title="Xem danh sách ứng viên"><i class="bi bi-people"></i></button>
                                    <button class="btn btn-outline-warning btn-sm mb-1" title="Sửa tin"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-outline-danger btn-sm mb-1" title="Dừng tuyển"><i class="bi bi-pause-circle"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong class="text-primary">Chuyên viên Phân tích Dữ liệu</strong><br>
                                    <small class="text-muted">Đăng ngày: 10/10/2026</small>
                                </td>
                                <td>15/11/2026</td>
                                <td class="text-center">
                                    <span class="badge text-bg-info fs-6">12</span>
                                </td>
                                <td><span class="badge text-bg-success">Đang tuyển</span></td>
                                <td class="text-center">
                                    <button class="btn btn-outline-primary btn-sm mb-1"><i class="bi bi-people"></i></button>
                                    <button class="btn btn-outline-warning btn-sm mb-1"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-outline-danger btn-sm mb-1"><i class="bi bi-pause-circle"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong class="text-secondary">Thực tập sinh C# WinForms</strong><br>
                                    <small class="text-muted">Đăng ngày: 01/09/2026</small>
                                </td>
                                <td>30/09/2026</td>
                                <td class="text-center">
                                    <span class="badge text-bg-secondary fs-6">45</span>
                                </td>
                                <td><span class="badge text-bg-secondary">Đã đóng</span></td>
                                <td class="text-center">
                                    <button class="btn btn-outline-secondary btn-sm mb-1" title="Xem lại báo cáo"><i class="bi bi-file-bar-graph"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer text-center">
                <a href="#" class="text-decoration-none">Xem toàn bộ tin tuyển dụng</a>
            </div>
        </div>
    </div>

    <!-- Cột phải: Feed ứng viên mới & Lời nhắc (Chiếm 4 cột) -->
    <div class="col-lg-4">
        <!-- Box Hồ sơ mới nạp -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header text-bg-warning">
                <h3 class="card-title text-dark fw-bold"><i class="bi bi-lightning-charge"></i> Hồ sơ mới nhất</h3>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-bold">Trần Thị B</div>
                            <small class="text-muted">Ứng tuyển: <strong>Phân tích Dữ liệu</strong></small><br>
                            <small class="text-danger"><i class="bi bi-clock"></i> 15 phút trước</small>
                        </div>
                        <button class="btn btn-sm btn-info text-white"><i class="bi bi-eye"></i> Xem CV</button>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-bold">Lê Văn C</div>
                            <small class="text-muted">Ứng tuyển: <strong>ASP.NET Core</strong></small><br>
                            <small class="text-muted"><i class="bi bi-clock"></i> 2 giờ trước</small>
                        </div>
                        <button class="btn btn-sm btn-info text-white"><i class="bi bi-eye"></i> Xem CV</button>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-bold">Nguyễn Văn A</div>
                            <small class="text-muted">Ứng tuyển: <strong>ASP.NET Core</strong></small><br>
                            <small class="text-muted"><i class="bi bi-clock"></i> Hôm qua</small>
                        </div>
                        <button class="btn btn-sm btn-info text-white"><i class="bi bi-eye"></i> Xem CV</button>
                    </li>
                </ul>
            </div>
            <div class="card-footer text-center">
                <a href="#" class="text-decoration-none">Tới trang quản lý ứng viên</a>
            </div>
        </div>

        <!-- Box Tiện ích / Nút Call to Action nhanh -->
        <div class="card shadow-sm">
            <div class="card-header">
                <h3 class="card-title fw-bold">Công cụ nhanh</h3>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <button class="btn btn-outline-success text-start"><i class="bi bi-search me-2"></i> Tìm kiếm ứng viên (Search CV)</button>
                    <button class="btn btn-outline-primary text-start"><i class="bi bi-envelope-paper me-2"></i> Gửi email mời phỏng vấn</button>
                    <button class="btn btn-outline-secondary text-start"><i class="bi bi-graph-up me-2"></i> Báo cáo hiệu quả tuyển dụng</button>
                </div>
            </div>
        </div>
    </div>
</div>